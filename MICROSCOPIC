
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TRUST™ | DATASIMOV Industries</title>
<meta name="description" content="DATASIMOV TRUST - Executive Integrity and Corporate Intelligence Protection.">
<style>
:root {
  --bg:#070b12;
  --panel:#0d1623;
  --line:#20354b;
  --cyan:#63e6ff;
  --blue:#398dff;
  --muted:#91a5b9;
  --white:#edf7ff;
  --green:#78f0c0;
}
* {box-sizing:border-box}
html {scroll-behavior:smooth}
body {
  margin:0;
  background:radial-gradient(ellipse at 70% 5%,#102b43 0,transparent 38%),var(--bg);
  color:var(--white);
  font:15px/1.6 Inter,system-ui,-apple-system,Segoe UI,sans-serif;
}
header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:22px 5%;
  border-bottom:1px solid #1b2c3d;
}
.brand {font-weight:900;letter-spacing:.18em}
.brand span {color:var(--cyan)}
nav a {
  color:var(--muted);
  text-decoration:none;
  margin-left:24px;
  font-size:12px;
  letter-spacing:.12em;
  text-transform:uppercase;
}
main {max-width:1120px;margin:auto;padding:68px 24px}
.eyebrow {
  color:var(--cyan);
  font-size:11px;
  letter-spacing:.25em;
  text-transform:uppercase;
}
h1 {
  font-size:clamp(48px,7vw,82px);
  line-height:.98;
  letter-spacing:-.055em;
  margin:15px 0 22px;
}
h1 span {color:var(--cyan)}
.lead {font-size:20px;color:#b7c8d8;max-width:680px}
.hero {
  display:grid;
  grid-template-columns:1fr 1.05fr;
  gap:44px;
  align-items:center;
}
.visual {
  border:1px solid var(--line);
  background:linear-gradient(145deg,#0c1c2d,#07101a);
  border-radius:14px;
  padding:18px;
  box-shadow:0 25px 80px #0008;
}
.visual svg {width:100%;height:auto;display:block}
.caption {
  display:flex;
  justify-content:space-between;
  color:var(--muted);
  font-size:10px;
  letter-spacing:.12em;
  margin-top:10px;
}
.actions {display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.btn {
  border:1px solid var(--cyan);
  background:var(--cyan);
  color:#04111a;
  padding:12px 18px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
  cursor:pointer;
  border-radius:4px;
}
.btn.secondary {background:transparent;color:var(--cyan)}
section {margin-top:82px}
.section-head {
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:20px;
  border-bottom:1px solid var(--line);
  padding-bottom:14px;
}
h2 {font-size:27px;margin:0;letter-spacing:-.03em}
.section-head p {color:var(--muted);margin:0;font-size:12px}
.grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
  margin-top:20px;
}
.card {
  background:var(--panel);
  border:1px solid var(--line);
  padding:20px;
  border-radius:8px;
}
.card .num {color:var(--cyan);font-size:11px;letter-spacing:.15em}
.card h3 {margin:9px 0 6px;font-size:16px}
.card p {color:var(--muted);font-size:13px;margin:0}
.metrics {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-top:20px;
}
.metric {
  border-top:2px solid var(--cyan);
  padding:15px;
  background:#0a121d;
}
.metric strong {display:block;font-size:27px}
.metric small {
  color:var(--muted);
  letter-spacing:.1em;
  text-transform:uppercase;
}
.console {
  background:#03080d;
  border:1px solid #1d3b4c;
  border-radius:8px;
  padding:20px;
  margin-top:20px;
  font:13px/1.8 monospace;
  color:var(--green);
  min-height:112px;
  white-space:pre-wrap;
}
.notice {
  border-left:3px solid var(--cyan);
  padding:14px 18px;
  background:#0b1723;
  color:#aebfd0;
  font-size:12px;
  margin-top:55px;
}
footer {
  border-top:1px solid var(--line);
  padding:26px 5%;
  color:var(--muted);
  font-size:11px;
  display:flex;
  justify-content:space-between;
  gap:20px;
  flex-wrap:wrap;
}
@media(max-width:760px) {
  .hero {grid-template-columns:1fr}
  .grid {grid-template-columns:1fr}
  .metrics {grid-template-columns:1fr}
  nav {display:none}
  main {padding-top:45px}
}
</style>
</head>

