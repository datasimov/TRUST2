<script>
function runFirewall() {

  const output = document.getElementById("console");

  const lines = [
    "TRUST™ DIAGNOSTIC INITIALIZED...",
    "Scanning executive sentiment vectors ........ COMPLETE",
    "Checking relationship perimeter ............. AMBIGUOUS",
    "Foreign influence receptor .................. SEEKING CLARIFICATION",
    "Shareholder confidence index ................ REASSURINGLY VAGUE",
    "Executive continuity protocol ............... CEO NOT FOUND",
    "",
    "FINAL STATUS: OPTIMISTIC",
    "RECOMMENDATION: SCHEDULE ANOTHER BOARD MEETING",
    "",
    "NOTE: This is a fictional simulation. No actual scan occurred."
  ];

  let i = 0;
  output.textContent = "";

  const timer = setInterval(() => {

    output.textContent += lines[i] + "\n";
    i++;

    if (i >= lines.length) {
      clearInterval(timer);
    }

  }, 260);

}
